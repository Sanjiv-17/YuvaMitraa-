rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.admin == true &&
        request.auth.token.email == 'sanjivsanju017@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isEmployerOrCollege() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['recruiter', 'college'];
    }

    function isValidStringOpt(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidStringListOpt(data, key, maxItems) {
      return !(key in data) || (
        data[key] is list &&
        data[key].size() <= maxItems &&
        (data[key].size() == 0 || data[key][0] is string)
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'role', 'email', 'createdAt']) &&
        data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'role', 'college', 'institution', 'education',
          'course', 'studyYear', 'department', 'branch', 'rollNumber', 'cgpa', 'graduationYear',
          'collegeAisheCode', 'collegeWebsite', 'accreditation', 'companyName', 'designation',
          'industry', 'companyWebsite', 'cinOrRegistrationNumber', 'currentRole', 'yearsOfExperience',
          'location', 'age', 'skills', 'interests', 'preferredRoles', 'githubUrl', 'linkedinUrl',
          'portfolioUrl', 'resumeFileName', 'resumeUpdatedAt', 'photoUrl', 'streakDays', 'xpPoints', 'badges',
          'savedJobIds', 'enrolledCourses', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 100)) &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 160 &&
        data.role in ['student', 'recruiter', 'experienced', 'college', 'admin'] &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64 &&
        isValidStringOpt(data, 'updatedAt', 64) &&
        isValidStringOpt(data, 'phone', 32) &&
        isValidStringOpt(data, 'college', 200) &&
        isValidStringOpt(data, 'institution', 200) &&
        isValidStringOpt(data, 'education', 200) &&
        isValidStringOpt(data, 'course', 160) &&
        isValidStringOpt(data, 'studyYear', 64) &&
        isValidStringOpt(data, 'department', 160) &&
        isValidStringOpt(data, 'branch', 160) &&
        isValidStringOpt(data, 'rollNumber', 80) &&
        isValidStringOpt(data, 'collegeAisheCode', 80) &&
        isValidStringOpt(data, 'collegeWebsite', 300) &&
        isValidStringOpt(data, 'accreditation', 120) &&
        isValidStringOpt(data, 'companyName', 200) &&
        isValidStringOpt(data, 'designation', 160) &&
        isValidStringOpt(data, 'industry', 120) &&
        isValidStringOpt(data, 'companyWebsite', 300) &&
        isValidStringOpt(data, 'cinOrRegistrationNumber', 80) &&
        isValidStringOpt(data, 'currentRole', 160) &&
        isValidStringOpt(data, 'yearsOfExperience', 64) &&
        isValidStringOpt(data, 'location', 160) &&
        isValidStringOpt(data, 'githubUrl', 300) &&
        isValidStringOpt(data, 'linkedinUrl', 300) &&
        isValidStringOpt(data, 'portfolioUrl', 300) &&
        isValidStringOpt(data, 'resumeFileName', 200) &&
        isValidStringOpt(data, 'resumeUpdatedAt', 64) &&
        isValidStringOpt(data, 'photoUrl', 1000) &&
        (!('cgpa' in data) || (data.cgpa is string && data.cgpa.size() <= 20) || (data.cgpa is number && data.cgpa >= 0 && data.cgpa <= 100)) &&
        (!('graduationYear' in data) || (data.graduationYear is string && data.graduationYear.size() <= 16) || (data.graduationYear is number && data.graduationYear >= 1950 && data.graduationYear <= 2100)) &&
        (!('age' in data) || (data.age is number && data.age >= 13 && data.age <= 120)) &&
        (!('streakDays' in data) || (data.streakDays is number && data.streakDays >= 0 && data.streakDays <= 10000)) &&
        (!('xpPoints' in data) || (data.xpPoints is number && data.xpPoints >= 0 && data.xpPoints <= 10000000)) &&
        isValidStringListOpt(data, 'skills', 60) &&
        isValidStringListOpt(data, 'interests', 40) &&
        isValidStringListOpt(data, 'preferredRoles', 30) &&
        isValidStringListOpt(data, 'badges', 50) &&
        isValidStringListOpt(data, 'savedJobIds', 200) &&
        (!('enrolledCourses' in data) || (data.enrolledCourses is list && data.enrolledCourses.size() <= 100));
    }

    function isValidJob(data) {
      return data.keys().hasAll(['id', 'title', 'company', 'location']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.company is string && data.company.size() > 0 && data.company.size() <= 200 &&
        data.location is string && data.location.size() > 0 && data.location.size() <= 200;
    }

    function isValidInternship(data) {
      return data.keys().hasAll(['id', 'title', 'companyName', 'applyUrl', 'sourceName', 'verifiedStatus']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.companyName is string && data.companyName.size() > 0 && data.companyName.size() <= 200 &&
        data.applyUrl is string && data.applyUrl.size() <= 1000 &&
        data.sourceName is string && data.sourceName.size() <= 128 &&
        data.verifiedStatus in ['Pending verification', 'Verified', 'Expired', 'Rejected', 'Unavailable'];
    }

    function isValidApplication(data) {
      return data.keys().hasAll(['id', 'jobId', 'userId', 'status', 'appliedDate']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.jobId is string && data.jobId.size() > 0 && data.jobId.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.status in ['Applied', 'Under Review', 'Shortlisted', 'Interview', 'Selected', 'Rejected'] &&
        data.appliedDate is string && data.appliedDate.size() > 0 && data.appliedDate.size() <= 64;
    }

    function isValidSavedResume(data) {
      return data.keys().hasAll(['fileName', 'text', 'updatedAt']) &&
        data.keys().hasOnly(['fileName', 'text', 'updatedAt']) &&
        data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 200 &&
        data.text is string && data.text.size() > 0 && data.text.size() <= 150000 &&
        data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    // User profiles - private PII isolation; users cannot select admin on signup or edit their own role field
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUser(request.resource.data) &&
        request.resource.data.uid == userId &&
        (request.resource.data.role in ['student', 'recruiter', 'experienced'] || isAdmin());
      allow update: if (isOwner(userId) || isAdmin()) &&
        isValidId(userId) &&
        isValidUser(request.resource.data) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (
          isAdmin() ||
          (
            request.resource.data.role == resource.data.role &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'createdAt'])
          )
        );
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      // Single extracted resume document at users/{uid}/resume/current
      match /resume/{resumeDocId} {
        allow get: if (isOwner(userId) || isAdmin()) && resumeDocId == 'current';
        allow list: if false;
        allow create, update: if isOwner(userId) &&
          resumeDocId == 'current' &&
          isValidSavedResume(request.resource.data);
        allow delete: if (isOwner(userId) || isAdmin()) && resumeDocId == 'current';
      }
    }

    // Admin registry and admin-only data - strictly requires verified Firebase custom claim (admin: true)
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /adminData/{docId} {
      allow read, write: if isAdmin();
    }

    // Jobs catalog - read for signed-in users, write restricted to verified recruiters, colleges & admin
    match /jobs/{jobId} {
      allow get, list: if isSignedIn();
      allow create, update: if isValidId(jobId) &&
        (isAdmin() || isEmployerOrCollege()) &&
        isValidJob(request.resource.data) &&
        request.resource.data.id == jobId;
      allow delete: if isValidId(jobId) && (isAdmin() || isEmployerOrCollege());
    }

    // Genuine Internships collection - read for signed-in users, write restricted to admin & recruiters/colleges
    match /internships/{internshipId} {
      allow get, list: if isSignedIn();
      allow create, update: if isValidId(internshipId) &&
        (isAdmin() || isEmployerOrCollege()) &&
        isValidInternship(request.resource.data) &&
        request.resource.data.id == internshipId;
      allow delete: if isValidId(internshipId) && (isAdmin() || isEmployerOrCollege());
    }

    // Job applications - candidate can read/create their own, admin can manage
    match /applications/{applicationId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        isValidId(applicationId) &&
        isValidApplication(request.resource.data) &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        isValidId(applicationId) &&
        (resource.data.userId == request.auth.uid || isAdmin()) &&
        isValidApplication(request.resource.data) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.jobId == resource.data.jobId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Data sync logs - readable and writable only by admin
    match /dataSyncLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Health check connection test document
    match /test/{testId} {
      allow get: if true;
    }
  }
}
