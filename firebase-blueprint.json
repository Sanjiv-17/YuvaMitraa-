{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered YuvaMitraa user account and career profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Authenticated user Firebase UID"
        },
        "name": {
          "type": "string",
          "description": "Full name of the student or recruiter"
        },
        "email": {
          "type": "string",
          "description": "Verified email address"
        },
        "phone": {
          "type": "string",
          "description": "Verified mobile phone number"
        },
        "role": {
          "type": "string",
          "enum": ["student", "recruiter", "experienced", "college", "admin"],
          "description": "User role on YuvaMitraa"
        },
        "currentRole": {
          "type": "string",
          "description": "Current or previous professional role for experienced candidates"
        },
        "yearsOfExperience": {
          "type": "string",
          "description": "Years of professional work experience"
        },
        "course": {
          "type": "string",
          "description": "Course or degree program"
        },
        "studyYear": {
          "type": "string",
          "description": "Current academic year or semester"
        },
        "education": {
          "type": "string",
          "description": "Education qualification summary"
        },
        "institution": {
          "type": "string",
          "description": "Institution name"
        },
        "college": {
          "type": "string",
          "description": "College or university institution"
        },
        "department": {
          "type": "string",
          "description": "Degree and specialization"
        },
        "branch": {
          "type": "string",
          "description": "Academic branch (e.g. Computer Science)"
        },
        "rollNumber": {
          "type": "string",
          "description": "Student roll or registration number"
        },
        "cgpa": {
          "type": "string",
          "description": "Cumulative GPA score"
        },
        "graduationYear": {
          "type": "string",
          "description": "Year of graduation"
        },
        "collegeAisheCode": {
          "type": "string",
          "description": "AISHE institutional accreditation code"
        },
        "collegeWebsite": {
          "type": "string",
          "description": "Official college website URL"
        },
        "accreditation": {
          "type": "string",
          "description": "Institutional accreditation status"
        },
        "companyName": {
          "type": "string",
          "description": "Employer company name"
        },
        "designation": {
          "type": "string",
          "description": "Recruiter or professional designation"
        },
        "industry": {
          "type": "string",
          "description": "Industry sector"
        },
        "companyWebsite": {
          "type": "string",
          "description": "Official company website URL"
        },
        "cinOrRegistrationNumber": {
          "type": "string",
          "description": "Corporate CIN or official registration code"
        },
        "location": {
          "type": "string",
          "description": "Current city or state in India"
        },
        "age": {
          "type": "number",
          "description": "User age in years"
        },
        "skills": {
          "type": "array",
          "description": "Candidate technical skills list"
        },
        "nonTechnicalSkills": {
          "type": "array",
          "description": "Candidate soft and non-technical skills list"
        },
        "interests": {
          "type": "array",
          "description": "Areas of interest list"
        },
        "preferredRoles": {
          "type": "array",
          "description": "Preferred job roles"
        },
        "preferredDomain": {
          "type": "string",
          "maxLength": 160,
          "description": "Preferred internship domain"
        },
        "careerGoals": {
          "type": "string",
          "maxLength": 500,
          "description": "Student career goals and aspirations"
        },
        "preferredLocation": {
          "type": "string",
          "maxLength": 160,
          "description": "Preferred internship location"
        },
        "workModePreference": {
          "type": "string",
          "enum": ["Online", "Offline", "Hybrid", "Any"],
          "description": "Preferred work mode (Online, Offline, Hybrid, or Any)"
        },
        "githubUrl": {
          "type": "string",
          "description": "GitHub profile URL"
        },
        "linkedinUrl": {
          "type": "string",
          "description": "LinkedIn profile URL"
        },
        "portfolioUrl": {
          "type": "string",
          "description": "Portfolio website URL"
        },
        "resumeFileName": {
          "type": "string",
          "description": "Uploaded resume file name"
        },
        "resumeUpdatedAt": {
          "type": "string",
          "description": "Firestore serverTimestamp() (or ISO string for legacy records) recording when the user's resume was last uploaded or updated"
        },
        "profileUpdatedAt": {
          "type": "string",
          "description": "Firestore serverTimestamp() recording when the user last edited and saved their profile information"
        },
        "photoUrl": {
          "type": "string",
          "description": "Profile avatar URL"
        },
        "streakDays": {
          "type": "number",
          "description": "Active learning streak days"
        },
        "xpPoints": {
          "type": "number",
          "description": "Earned learning XP points"
        },
        "badges": {
          "type": "array",
          "description": "Earned skill badges"
        },
        "savedJobIds": {
          "type": "array",
          "description": "Bookmarked job IDs"
        },
        "enrolledCourses": {
          "type": "array",
          "description": "Enrolled courses and completion progress"
        },
        "projects": {
          "type": "array",
          "description": "Student portfolio projects"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account registration"
        },
        "updatedAt": {
          "type": "string",
          "description": "Firestore serverTimestamp() of last user document update"
        }
      },
      "required": ["uid", "role", "email", "createdAt"]
    },
    "Job": {
      "title": "Job",
      "description": "Internship or entry-level job posting",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "company": { "type": "string" },
        "location": { "type": "string" },
        "city": { "type": "string" },
        "stipend": { "type": "string" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "verificationStatus": { "type": "string" },
        "opportunitySource": { "type": "string" },
        "verificationEvidence": { "type": "string" },
        "postedDate": { "type": "string" }
      },
      "required": ["id", "title", "company", "location"]
    },
    "Application": {
      "title": "Application",
      "description": "Student job or internship application record with optional interview schedule and reminders",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "jobId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "jobTitle": { "type": "string", "maxLength": 200 },
        "company": { "type": "string", "maxLength": 200 },
        "candidateName": { "type": "string", "maxLength": 120 },
        "candidateEmail": { "type": "string", "maxLength": 160 },
        "candidatePhone": { "type": "string", "maxLength": 32 },
        "candidateCollege": { "type": "string", "maxLength": 200 },
        "status": {
          "type": "string",
          "enum": ["Applied", "Under Review", "Shortlisted", "Interview", "Selected", "Rejected"]
        },
        "appliedDate": { "type": "string", "maxLength": 64 },
        "updatedDate": { "type": "string", "maxLength": 64 },
        "coverLetter": { "type": "string", "maxLength": 3000 },
        "matchScore": { "type": "number" },
        "interviewDate": { "type": "string", "maxLength": 32 },
        "interviewTime": { "type": "string", "maxLength": 32 },
        "interviewMode": { "type": "string", "maxLength": 64 },
        "interviewLinkOrVenue": { "type": "string", "maxLength": 300 },
        "recruiterFeedback": { "type": "string", "maxLength": 1000 },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "jobId", "userId", "status", "appliedDate"]
    },
    "Internship": {
      "title": "Internship",
      "description": "Genuine internship opportunity from AICTE and verified partners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "companyName": { "type": "string" },
        "description": { "type": "string" },
        "eligibility": { "type": "string" },
        "skills": { "type": "array" },
        "location": { "type": "string" },
        "workMode": { "type": "string", "enum": ["Remote", "On-site", "Hybrid"] },
        "duration": { "type": "string" },
        "stipend": { "type": "string" },
        "applicationDeadline": { "type": "string" },
        "applyUrl": { "type": "string" },
        "sourceName": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "sourceId": { "type": "string" },
        "verifiedStatus": { "type": "string", "enum": ["Pending verification", "Verified", "Expired", "Rejected", "Unavailable"] },
        "lastVerifiedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "companyName", "applyUrl", "sourceName", "verifiedStatus"]
    },
    "DataSyncLog": {
      "title": "DataSyncLog",
      "description": "Synchronization audit log for external API adapters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sourceName": { "type": "string" },
        "lastSyncAt": { "type": "string" },
        "status": { "type": "string", "enum": ["SUCCESS", "PARTIAL", "FAILED", "CONFIG_REQUIRED"] },
        "fetchedCount": { "type": "number" },
        "insertedCount": { "type": "number" },
        "updatedCount": { "type": "number" },
        "duplicateCount": { "type": "number" },
        "errorMessage": { "type": "string" }
      },
      "required": ["sourceName", "lastSyncAt", "status", "fetchedCount"]
    },
    "SavedResume": {
      "title": "SavedResume",
      "description": "Extracted resume text and metadata stored at users/{uid}/resume/current",
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string",
          "maxLength": 200,
          "description": "Original PDF resume filename"
        },
        "text": {
          "type": "string",
          "maxLength": 150000,
          "description": "Plain resume text extracted in-browser via pdf.js"
        },
        "updatedAt": {
          "type": "string",
          "description": "Firestore serverTimestamp() recording when resume was uploaded, replaced, or updated"
        }
      },
      "required": ["fileName", "text", "updatedAt"]
    },
    "SavedRecommendations": {
      "title": "SavedRecommendations",
      "description": "Private personalized internship recommendations and skill gap snapshot stored at users/{uid}/recommendations/current",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Owner student UID"
        },
        "profileSignature": {
          "type": "string",
          "maxLength": 256,
          "description": "Profile fingerprint used to compute recommendations"
        },
        "recommendations": {
          "type": "array",
          "description": "Ranked internship matches with weighted score breakdown and skill gap info"
        },
        "overallMissingSkills": {
          "type": "array",
          "description": "Top missing skills the student should improve"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp when recommendations were generated"
        }
      },
      "required": ["userId", "profileSignature", "recommendations", "updatedAt"]
    },
    "UserCertificate": {
      "title": "UserCertificate",
      "description": "Earned or uploaded certificate strictly owned by a single authenticated user at users/{uid}/certificates/{certificateId}",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique certificate document ID"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Owner Firebase Authentication UID"
        },
        "certificateCode": {
          "type": "string",
          "maxLength": 80,
          "description": "Verification code or credential ID"
        },
        "studentName": {
          "type": "string",
          "maxLength": 120,
          "description": "Recipient name"
        },
        "courseId": {
          "type": "string",
          "maxLength": 128,
          "description": "Course identifier or external-upload"
        },
        "courseTitle": {
          "type": "string",
          "maxLength": 200,
          "description": "Certificate title or course name"
        },
        "issueDate": {
          "type": "string",
          "maxLength": 64,
          "description": "Date issued (YYYY-MM-DD)"
        },
        "scorePercentage": {
          "type": "number",
          "description": "Exam score percentage (0-100)"
        },
        "qrData": {
          "type": "string",
          "maxLength": 500,
          "description": "Verification URL encoded in QR"
        },
        "instructor": {
          "type": "string",
          "maxLength": 160,
          "description": "Issuing instructor or organization"
        },
        "source": {
          "type": "string",
          "enum": ["earned", "uploaded"],
          "description": "Whether the certificate was earned on YuvaMitraa or uploaded by the user"
        },
        "issuer": {
          "type": "string",
          "maxLength": 160,
          "description": "Issuing organization name"
        },
        "credentialUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional external verification URL"
        },
        "fileName": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional uploaded certificate filename"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of certificate creation"
        }
      },
      "required": ["id", "userId", "certificateCode", "studentName", "courseTitle", "issueDate"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents indexed by user Firebase UID"
    },
    "/users/{userId}/resume/{resumeId}": {
      "schema": "SavedResume",
      "description": "Single extracted resume document ('current') per user, overwritten on re-upload"
    },
    "/users/{userId}/recommendations/{recId}": {
      "schema": "SavedRecommendations",
      "description": "Private personalized AI internship recommendation cache ('current') per student"
    },
    "/users/{userId}/certificates/{certificateId}": {
      "schema": "UserCertificate",
      "description": "Private earned and uploaded certificates strictly isolated per user UID"
    },
    "/admins/{adminId}": {
      "schema": "User",
      "description": "Admin registry records accessible only to claim-verified admins"
    },
    "/adminData/{docId}": {
      "schema": "DataSyncLog",
      "description": "Protected administrative metadata accessible only to claim-verified admins"
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Verified job and internship listings"
    },
    "/internships/{internshipId}": {
      "schema": "Internship",
      "description": "Genuine internships from AICTE portal and authorized feeds"
    },
    "/applications/{applicationId}": {
      "schema": "Application",
      "description": "User internship applications"
    },
    "/dataSyncLogs/{logId}": {
      "schema": "DataSyncLog",
      "description": "Integration synchronization logs"
    }
  }
}
