# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration for Phone & Web Authentication
# Set these in your environment or .env file to override the default Firebase project
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# External Job & Internship Integration Adapters (All Keys Optional)
# App startup is never blocked if an optional key is missing; missing sources are skipped while others continue syncing.
# Never use fake API keys or demo data.

# IndianAPI Jobs API (Optional - Get key from https://indianapi.in/)
INDIANAPI_KEY=""

# AICTE National Internship Portal Partner Credentials (Optional - Integrate only when authorized credentials exist)
AICTE_API_KEY=""
AICTE_CLIENT_ID=""

# National Career Service (NCS) Ministry of Labour & Employment API (Optional - Do not assume public API exists)
NCS_API_KEY=""

# Automatic Data Refresh Interval in Hours (Default: 6)
SYNC_INTERVAL="6"
SYNC_INTERVAL_HOURS="6"


